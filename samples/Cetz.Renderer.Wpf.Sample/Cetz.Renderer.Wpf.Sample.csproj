<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cetz.Renderer.Wpf\Cetz.Renderer.Wpf.csproj" />
    <ProjectReference Include="..\Cetz.Renderer.Demo.Shared\Cetz.Renderer.Demo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\artifacts\native\win-x64\cetz_dotnet_native.dll"
          Link="cetz_dotnet_native.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\native\win-x64\cetz_dotnet_native.dll')" />
  </ItemGroup>
</Project>
