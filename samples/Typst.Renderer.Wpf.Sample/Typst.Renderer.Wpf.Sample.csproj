<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePublishedPackages)' != 'true'">
    <ProjectReference Include="..\..\src\Typst.Renderer.Wpf\Typst.Renderer.Wpf.csproj" />
    <ProjectReference Include="..\Typst.Renderer.Demo.Shared\Typst.Renderer.Demo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedPackages)' == 'true'">
    <PackageReference Include="Typst.Renderer.Wpf" Version="[$(PublishedPackageVersion)]" />
    <PackageReference Include="$(PublishedNativePackageId)" Version="[$(PublishedPackageVersion)]" />
    <ProjectReference Include="..\Typst.Renderer.Demo.Shared\Typst.Renderer.Demo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedPackages)' != 'true'">
    <None Include="..\..\artifacts\native\win-x64\typst_dotnet_native.dll"
          Link="typst_dotnet_native.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\native\win-x64\typst_dotnet_native.dll')" />
  </ItemGroup>
</Project>
