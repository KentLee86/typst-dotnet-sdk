<Page
    x:Class="Cetz.Renderer.Uno.Sample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cetz="using:Cetz.Renderer.Uno"
    Background="#EEF2F7">
  <Grid ColumnDefinitions="420,*">
    <Grid Grid.Column="0" Padding="22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Background="White">
      <StackPanel Spacing="6">
        <TextBlock Text="Demo resource" FontWeight="SemiBold" />
        <ComboBox x:Name="DemoPicker" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" />
        <TextBlock x:Name="DescriptionText" Foreground="#64748B" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
        <TextBlock Text="Typst / CeTZ source" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="RenderButton" Grid.Column="1" Content="Render" Click="OnRenderClicked" />
      </Grid>

      <TextBox
          x:Name="SourceEditor"
          Grid.Row="2"
          AcceptsReturn="True"
          FontFamily="Consolas"
          FontSize="13"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          TextWrapping="NoWrap"
          ScrollViewer.VerticalScrollBarVisibility="Auto" />

      <TextBlock x:Name="StatusText" Grid.Row="3" Text="Ready" Foreground="#64748B" TextWrapping="Wrap" />
    </Grid>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <StackPanel Padding="18,12" Orientation="Horizontal" Spacing="10" Background="#F8FAFC">
        <TextBlock Text="Zoom" VerticalAlignment="Center" />
        <ComboBox x:Name="ZoomModePicker" Width="120" SelectedIndex="0" SelectionChanged="OnZoomModeChanged">
          <ComboBoxItem Content="Custom" />
          <ComboBoxItem Content="Fit width" />
          <ComboBoxItem Content="Fit page" />
        </ComboBox>
        <Slider x:Name="ZoomSlider" Width="150" Minimum="0.1" Maximum="8" Value="0.9" StepFrequency="0.05" ValueChanged="OnZoomChanged" />
        <TextBlock x:Name="ZoomText" Text="90%" VerticalAlignment="Center" MinWidth="48" />
        <TextBlock Text="View" VerticalAlignment="Center" Margin="8,0,0,0" />
        <ComboBox x:Name="ViewModePicker" Width="160" SelectedIndex="0" SelectionChanged="OnViewModeChanged">
          <ComboBoxItem Content="Continuous (1)" />
          <ComboBoxItem Content="Continuous (2)" />
          <ComboBoxItem Content="Single page" />
          <ComboBoxItem Content="Facing pages" />
        </ComboBox>
        <Button Content="Previous" Click="OnPreviousClicked" />
        <Button Content="Next" Click="OnNextClicked" />
        <TextBlock x:Name="PageIndicator" Text="0 / 0" VerticalAlignment="Center" />
      </StackPanel>
      <ScrollViewer
          x:Name="PreviewScroller"
          Grid.Row="1"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto"
          SizeChanged="OnPreviewViewportChanged">
        <Border Padding="28">
          <cetz:CetzView x:Name="Preview" Zoom="0.9" PageSpacing="24" />
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
