<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.26100;net8.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Typst.Renderer Uno Sample</ApplicationTitle>
    <ApplicationId>com.kentlee86.cetzrenderer.uno.sample</ApplicationId>
    <ApplicationDisplayVersion>$(SdkVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>KentLee86</ApplicationPublisher>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Description>Interactive Uno Platform sample for Typst.Renderer.</Description>
    <UnoFeatures />
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePublishedPackages)' != 'true'">
    <ProjectReference Include="..\..\src\Typst.Renderer.Uno\Typst.Renderer.Uno.csproj" />
    <ProjectReference Include="..\Typst.Renderer.Demo.Shared\Typst.Renderer.Demo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedPackages)' == 'true'">
    <PackageReference Include="Typst.Renderer.Uno" Version="[$(PublishedPackageVersion)]" />
    <PackageReference Include="$(PublishedNativePackageId)" Version="[$(PublishedPackageVersion)]" />
    <ProjectReference Include="..\Typst.Renderer.Demo.Shared\Typst.Renderer.Demo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedPackages)' != 'true'">
    <None Include="..\..\artifacts\native\win-x64\typst_dotnet_native.dll"
          Link="typst_dotnet_native.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\native\win-x64\typst_dotnet_native.dll')" />
  </ItemGroup>
</Project>
