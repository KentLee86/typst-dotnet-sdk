<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Cetz.Renderer.Native.win-x64</PackageId>
    <Description>Windows x64 native runtime for Cetz.Renderer</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>Cetz.Renderer.Native.win-x64.nuspec</NuspecFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cetz.Renderer\Cetz.Renderer.csproj" PrivateAssets="all" />
    <None Include="_._" Pack="true" PackagePath="lib/net8.0/" />
    <None Include="..\..\artifacts\native\win-x64\cetz_dotnet_native.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
