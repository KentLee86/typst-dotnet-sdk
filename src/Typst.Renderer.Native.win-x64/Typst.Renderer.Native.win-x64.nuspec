<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Typst.Renderer.Native.win-x64</id>
    <version>$version$</version>
    <authors>KentLee86</authors>
    <description>Windows x64 native runtime for Typst.Renderer</description>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <repository type="git" url="https://github.com/KentLee86/typst-dotnet-sdk" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Typst.Renderer" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\artifacts\native\win-x64\typst_dotnet_native.dll" target="runtimes\win-x64\native" />
    <file src="..\..\README.md" target="" />
    <file src="_._" target="lib\net8.0" />
  </files>
</package>
