<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <TypstNativePackage Condition="'$(TypstNativePackage)' == ''">Typst.Renderer.Native.win-x64</TypstNativePackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(TypstNativePackage)" Version="0.1.0" />
    <PackageReference Include="Typst.Renderer.Wpf" Version="0.1.0" />
  </ItemGroup>
</Project>
