<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <TypstNativePackage Condition="'$(TypstNativePackage)' == ''">Typst.Renderer.Native.win-x64</TypstNativePackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Typst.Renderer.WinForms" Version="0.1.0" />
    <PackageReference Include="$(TypstNativePackage)" Version="0.1.0" />
  </ItemGroup>
</Project>
